# 飞书应用凭据
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 模型配置
FEISHU_PI_MODEL_PROVIDER=anthropic
FEISHU_PI_MODEL_NAME=claude-sonnet-4-6
FEISHU_PI_MODEL_BASE_URL=
FEISHU_PI_MODEL_API_KEY=

# 智能体审核（策略外调用的综合判断，OpenAI 兼容接口；不配置时策略外调用直接弹卡）
# FEISHU_GUARD_BASE_URL=
# FEISHU_GUARD_MODEL=
# FEISHU_GUARD_API_KEY=

# 组成员归属关系（可选）：FEISHU_GROUP_<组名>=成员1,成员2,...
# 组名对应 .agent/permissions.json 中的组键名（不区分大小写，如 admin、group1）
# 成员可以是 open_id、中文名、英文名，逗号分隔；FEISHU_ADMIN 自动属于 admin 组
# FEISHU_GROUP_ADMIN=何小书
# FEISHU_GROUP_USER1=李雷,韩梅梅

# 用户飞书身份授权（Device Flow，/login 指令）：scope 已内置默认
# （contact:contact.base:readonly + contact:user.base:readonly + contact:user.department:readonly
#   + contact:department.base:readonly + contact:user.department_path:readonly，用户资料查询所需），无需配置；
