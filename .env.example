# 飞书应用凭据（缺失时启动会进入扫码开通向导自动写入）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 模型配置（供应商由模型名自动推断：带 claude → anthropic、带 deepseek → deepseek、其余 → openai）
FEISHU_PI_MODEL_NAME=deepseek-flash
FEISHU_PI_MODEL_BASE_URL=https://api.deepseek.com
FEISHU_PI_MODEL_API_KEY=

# 思考档位：off / low / high / max（不配置 = off；不同模型自动适配等效等级）
# FEISHU_PI_THINKING_LEVEL=high
# 资源与会话背压（可选）：单个资源 MiB、单条消息总资源 MiB、单会话排队上限
# FEISHU_PI_MAX_RESOURCE_MB=20
# FEISHU_PI_MAX_MESSAGE_RESOURCE_MB=40
# FEISHU_PI_MAX_PENDING_MESSAGES=3

# MiniPet 桌面前端通过本地 stdin/stdout 接入，不监听端口。
# 本地授权卡必须配置真实的飞书用户 Open ID；否则 MiniPet 只能收发消息，不能在桌面端批准工具调用。
# MINIPET_USER_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxx


# 智能门禁（白名单未命中时的综合判断，OpenAI 兼容接口；不配置则弹管理员卡）
FEISHU_GUARD_BASE_URL=
FEISHU_GUARD_MODELS=
FEISHU_GUARD_API_KEY=

# 管理员（负责人）：中文名 / 英文名 / open_id / 邮箱；自动属于 admin 组
FEISHU_PI_ADMIN=何小书

# 服务上线/下线时向管理员私聊的文本；可写 \\n+ 换行，下线文本可用 {signal} 插入 SIGINT / SIGTERM 等信号名
FEISHU_PI_ONLINE_NOTICE=🟢 mini-claw 已上线，飞书通道、权限门禁和定时任务已就绪。
FEISHU_PI_OFFLINE_NOTICE=🔴 mini-claw 正在下线（{signal}）。

# 唯一团队成员（可选）：FEISHU_PI_GROUP 对应唯一团队角色 group
# 成员：open_id、中文名、英文名或部门名（如 系统工程部）
# FEISHU_PI_GROUP=李雷,韩梅梅,系统工程部

# 系统提示（身份 + 行为规则）：见 .agent/SYSTEM.md（Pi 原生发现，不入 .env）
