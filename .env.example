# 飞书应用凭据
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Agent 文件工具允许访问的工作目录
# 留空时使用项目根目录；建议填写专用、无敏感文件的目录
FEISHU_PI_CWD=

# Pi Session 和消息状态保存目录
FEISHU_PI_SESSION_DIR=./data/sessions

# 模型配置
FEISHU_PI_MODEL_PROVIDER=anthropic
FEISHU_PI_MODEL_ID=claude-sonnet-4-6
FEISHU_PI_MODEL_BASE_URL=

# API Keys（根据所选 provider 填写对应的 key）
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
