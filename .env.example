# 飞书应用凭据（缺失时启动会进入扫码开通向导自动写入）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 模型配置
FEISHU_PI_MODEL_PROVIDER=anthropic
FEISHU_PI_MODEL_NAME=claude-sonnet-4-6
FEISHU_PI_MODEL_BASE_URL=
FEISHU_PI_MODEL_API_KEY=

# 加密凭证库主密钥（64 位 hex）。首次启动自动生成并写入此文件；
# 备份/迁移服务时连同 .env 一起带走。丢失或更换后旧凭证数据无法解密（会被自动清空，需重新 /login）。
MINICLAW_VAULT_KEY=

# 智能体审核（策略外调用的综合判断，OpenAI 兼容接口；不配置时策略外调用直接弹卡）
# FEISHU_GUARD_BASE_URL=
# FEISHU_GUARD_MODEL=
# FEISHU_GUARD_API_KEY=

# 管理员（负责人）：中文名 / 英文名 / open_id / 邮箱；自动属于 admin 组。
# 注意：管理员只在这里配置——FEISHU_GROUP_ADMIN 已废弃，无需也不应再单独配置。
# FEISHU_ADMIN=何小书

# 组成员归属关系（可选）：
#   FEISHU_GROUP=成员1,成员2,...        → 主团队组 group_1
#   FEISHU_GROUP_1=... / FEISHU_GROUP_2=... → group_1 / group_2 …（与 .agent/permissions.json 的组名对应）
#   FEISHU_GROUP_<自定义组名>=...       → 对应 permissions.json 中同名组（小写）
# 成员可以是 open_id、中文名、英文名，或组织架构部门名——写部门名时，用户缓存的部门路径
# 包含该名称即视为组成员（部门来自 lark-cli 用户态搜索，无需审核权限）。
# FEISHU_GROUP=李雷,韩梅梅,系统工程部

# —— 以下可选键不配置即用代码默认值；需要调整时取消注释并修改 ——

# 智能体工作目录（读写文件的根目录；默认 = 启动目录）
# FEISHU_PI_CWD=
# 附加系统提示词（追加到默认系统提示之后；默认无）
# FEISHU_PI_SYSTEM_PROMPT=
# 授权卡等待超时，毫秒（默认 300000 = 5 分钟，超时视为拒绝）
# FEISHU_APPROVAL_TIMEOUT_MS=300000
# 智能体审核接口超时，毫秒（默认 15000）
# FEISHU_GUARD_TIMEOUT_MS=15000
# Meegle 站点（默认 project.feishu.cn；国际版为 meegle.com）
# MEEGLE_HOST=project.feishu.cn
# 用户飞书身份授权 scope（默认 contact:contact.base:readonly + contact:user.base:readonly
#   + contact:department.base:readonly，登录时自动追加 offline_access）
# FEISHU_USER_AUTH_SCOPES=contact:contact.base:readonly contact:user.base:readonly contact:department.base:readonly
