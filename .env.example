# 飞书应用凭据
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Agent 文件工具允许访问的工作目录
# 留空时使用项目根目录；建议填写专用、无敏感文件的目录
FEISHU_PI_CWD=

# 模型配置
FEISHU_PI_MODEL_PROVIDER=anthropic
FEISHU_PI_MODEL_NAME=claude-sonnet-4-6
FEISHU_PI_MODEL_BASE_URL=
FEISHU_PI_MODEL_API_KEY=

# 授权卡等待管理员点击的超时（毫秒，超时视为拒绝）
FEISHU_APPROVAL_TIMEOUT_MS=300000

# 智能体审核（策略外调用的综合判断，OpenAI 兼容接口；不配置时策略外调用直接弹卡）
# FEISHU_GUARD_BASE_URL=
# FEISHU_GUARD_MODEL=
# FEISHU_GUARD_API_KEY=
# FEISHU_GUARD_TIMEOUT_MS=15000

# 工具规则统一配置在 .agent/permissions.json（策略文件）
# FEISHU_CMD_WHITELIST 已废弃

# 组成员归属关系（可选）：FEISHU_GROUP_<组名>=成员1,成员2,...
# 组名对应 .agent/permissions.json 中的组键名（不区分大小写，如 owner、user1）
# 成员可以是 open_id、中文名、英文名，逗号分隔；FEISHU_ADMIN 自动属于 owner 组
# FEISHU_GROUP_OWNER=何小书
# FEISHU_GROUP_USER1=李雷,韩梅梅
