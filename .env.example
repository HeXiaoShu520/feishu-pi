# 飞书应用凭据（缺失时启动会进入扫码开通向导自动写入）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 模型配置（供应商由模型名自动推断：带 claude → anthropic、带 deepseek → deepseek、其余 → openai）
FEISHU_PI_MODEL_NAME=deepseek-flash
FEISHU_PI_MODEL_BASE_URL=https://api.deepseek.com
FEISHU_PI_MODEL_API_KEY=

# 思考档位：off / low / high / max（不配置 = off 关闭思考；不同模型自动适配等效等级）
# FEISHU_PI_THINKING_LEVEL=off


# 智能体审核（策略外调用的综合判断，OpenAI 兼容接口；不配置时策略外调用直接弹卡）
FEISHU_GUARD_BASE_URL=
FEISHU_GUARD_MODELS=
FEISHU_GUARD_API_KEY=

# 管理员（负责人）：中文名 / 英文名 / open_id / 邮箱；自动属于 admin 组
FEISHU_PI_ADMIN=何小书

# 组成员归属关系（可选）：FEISHU_PI_GROUP 对应主团队组 group；FEISHU_PI_GROUP_1/2…对应 group_1/2…
# 成员：open_id、中文名、英文名或部门名（如 系统工程部）
# FEISHU_PI_GROUP=李雷,韩梅梅,系统工程部

# 自定义人格：见仓库根目录 PERSONA.md（不入 .env）
