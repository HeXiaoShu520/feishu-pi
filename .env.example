# 飞书应用凭据（缺失时启动会进入扫码开通向导自动写入）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 模型配置（供应商由模型名自动推断：带 claude → anthropic、带 deepseek → deepseek、其余 → openai）
FEISHU_PI_MODEL_NAME=
FEISHU_PI_MODEL_BASE_URL=
FEISHU_PI_MODEL_API_KEY=

# 可选：加载 B 站自动浏览和自动回复服务（默认关闭；开启后仍需飞书私聊 /bili-auto on）
FEISHU_BILI_AUTO_AVAILABLE=false
# 可选：B 站自动浏览发现值得分享的视频时，向管理员私聊分享（每日最多一次）
FEISHU_BILI_SHARE_AVAILABLE=false

# 语音：优先读取飞书消息附带的 speech_to_text；缺失时可配置 OpenAI 兼容转写接口。
# FEISHU_PI_STT_MODEL=whisper-1
# FEISHU_PI_STT_BASE_URL=https://api.openai.com/v1
# FEISHU_PI_STT_API_KEY=

# 思考档位：off / low / high / max（不配置 = off；不同模型自动适配等效等级）
# FEISHU_PI_THINKING_LEVEL=high
# 回复末尾是否显示统计小字（模型 · 累计 token · 上下文占用 · 耗时 · 会话别名）
# 默认不显示（像个人说话）；想盯用量时设为 1
FEISHU_SHOW_MODEL_STATS=0
# 回复文字里是否允许 emoji 表情符号（默认允许，更像真人聊天；设为 0 关闭并在发送前剥离）
FEISHU_PI_REPLY_EMOJI=1
# 群聊主动接话（默认开启）：未 @ 时只在被叫名字、像在提问或有人发图时低概率接一句，
# 每群每小时最多 3 次、每次后冷却 10 分钟、深夜不主动。设为 0 后群聊只响应 @。
FEISHU_PI_GROUP_CHIME=1
# 有原话依据的聊天记忆（默认开启）：用户画像按人跨聊天共用，由 AI 必要时更新；
# 助手自我视角仍按聊天隔离。设为 0 关闭。
FEISHU_PI_AGENT_MEMORY=1
# 人格只由 .agent/SYSTEM.md 定义；旧 FEISHU_PI_PERSONA_GROWTH* 配置已退役。
# 群聊主动发言（默认关闭）。开启后只会在 FEISHU_PI_ACTIVE_CHATS 指定的群里，
# 群安静一段时间后，结合最近聊天说一句；没有自然想说的就跳过。
# 群 chatId 形如 oc_xxx，可从群设置或日志里拿到；多个用逗号分隔。
FEISHU_PI_PROACTIVE=0
FEISHU_PI_ACTIVE_CHATS=
# 可选：群安静多少分钟后考虑开口、两次开口冷却、每群每天上限、检查间隔（分钟）
# FEISHU_PI_PROACTIVE_IDLE_MINUTES=45
# FEISHU_PI_PROACTIVE_COOLDOWN_MINUTES=180
# FEISHU_PI_PROACTIVE_DAILY_LIMIT=2
# FEISHU_PI_PROACTIVE_CHECK_MINUTES=5
# 表情逐图描述：默认沿用上面的模型接口，可单独配置支持图片的模型。
# 仅本地批量生成脚本使用这三个配置；发送前预览由当前聊天模型自行判断。
# FEISHU_STICKER_VISION_MODEL=
# FEISHU_STICKER_VISION_BASE_URL=
# FEISHU_STICKER_VISION_API_KEY=
# 表情动图采样需要 Python + Pillow，默认 python；可指定 Python 可执行文件绝对路径。
# FEISHU_STICKER_PYTHON=python
# 资源与会话背压（可选）：单个资源 MiB、单条消息总资源 MiB、单会话排队上限、单轮工具调用上限、新消息打断前收尾窗口（毫秒，设 1 近似关闭等待）
# FEISHU_PI_MAX_RESOURCE_MB=20
# FEISHU_PI_MAX_MESSAGE_RESOURCE_MB=40
# FEISHU_PI_MAX_PENDING_MESSAGES=3
# FEISHU_ROUND_MAX_TOOL_CALLS=40
# FEISHU_PI_INTERRUPT_GRACE_MS=5000



# ask 规则审核模型（OpenAI 兼容）；未配置/失败时回退本人确认，不会放行 deny
FEISHU_GUARD_BASE_URL=
FEISHU_GUARD_MODELS=
FEISHU_GUARD_API_KEY=

# 本人的飞书 Open ID，推荐直接填 ou_...；只接受这个人的指令。
# 兼容旧 FEISHU_PI_ADMIN；旧姓名仅从本地缓存解析，不遍历通讯录。
FEISHU_PI_OWNER=

# 浏览器使用本机已安装的 Edge（Windows 默认）或 Chrome。
FEISHU_PI_BROWSER_CHANNEL=msedge

# 允许 AI 使用本人通过本工程 /login 主动授予的用户令牌。
# 0 保留原来只允许机器人身份与固定资料查询的限制；不会读取本机 CLI 缓存账号。
FEISHU_PI_USER_CLI=0

# 服务上线/下线时向本人私聊的文本；可写 \n+ 换行，下线文本可用 {signal} 插入 SIGINT / SIGTERM 等信号名
FEISHU_PI_ONLINE_NOTICE=🟢 feishu-pi 个人助理已上线。
FEISHU_PI_OFFLINE_NOTICE=🔴 feishu-pi 正在下线（{signal}）。

# 系统提示（身份 + 行为规则）：见 .agent/SYSTEM.md（Pi 原生发现，不入 .env）

# Optional: one desktop account resources/stickers directory. Exact file_key lookup only.
# Uncached stickers remain unreadable until the desktop client loads them.
FEISHU_PI_STICKER_CACHE_DIR=
