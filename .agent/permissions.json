{
  "_说明": "两个输入：deny=全局禁止读写的路径 glob 数组（第 0 层，先于一切 allow，对所有人含管理员生效），无内置默认、全部在此显式列出，可自行追加；allow=各身份组的规则数组，保留组名 common（所有人自动叠加）与 admin（FEISHU_PI_ADMIN 自动属于，未配置字段取全量缺省），其余组名任取。组成员在 .env 配置：FEISHU_PI_GROUP=成员 对应主团队组 group，FEISHU_PI_GROUP_1/2…对应 group_1/2…，自定义组用 FEISHU_PI_GROUP_<组名>；成员可以是 open_id、中文名、英文名或组织架构部门名（用户部门路径含该名称即入组）。allow 内每条规则为 Read(路径glob)、Write(路径glob)、Tools(工具名)、Bash(命令) 格式；_ 开头的键视为注释。修改即时生效（新会话起作用），/perm 可查看当前策略。",
  "deny": [
    ".env",
    ".env.local",
    ".env.development",
    ".env.production",
    ".env.test",
    "*.env",
    "*.key",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*.jks",
    "id_rsa*",
    "id_ed25519*",
    "id_ecdsa*",
    "*credential*",
    "*secret*",
    ".git-credentials",
    ".netrc"
  ],
  "allow": {
    "common": [
      "Read(.agent/skills/**)",
      "Read(README.md)",
      "Read(.env.example)",
      "Read(docs/**)",
      "Read(data/memory/**)",
      "Tools(memory)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run test:*)",
      "Bash(npm run check:*)"
    ],
    "admin": [
      "Read(**)",
      "Write(.agent/**)",
      "Write(data/**)",
      "Tools(*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm run check:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(pip install:*)",
      "Bash(gh auth:*)",
      "Bash(lark-cli docs:*)",
      "Bash(lark-cli im:*)",
      "Bash(lark-cli contact:*)",
      "Bash(lark-cli base:*)",
      "Bash(lark-cli sheets:*)",
      "Bash(lark-cli wiki:*)",
      "Bash(lark-cli drive:*)",
      "Bash(lark-cli calendar:*)",
      "Bash(lark-cli task:*)",
      "Bash(lark-cli approval:*)",
      "Bash(lark-cli mail:*)",
      "Bash(lark-cli okr:*)",
      "Bash(lark-cli meeting:*)",
      "Bash(lark-cli --help)"
    ],
    "group": [
      "Read(docs/**)",
      "Bash(npm run test:*)",
      "Bash(npm run check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
