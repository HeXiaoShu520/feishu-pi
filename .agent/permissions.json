{
  "_说明": "各组权限策略：admin=管理员组（FEISHU_ADMIN 或 FEISHU_GROUP_ADMIN 自动属于）；其余键=任意命名的组（如 group1、vip）。每条规则为 Read(路径glob)、Write(路径glob)、Tools(工具名)、Bash(命令) 格式。组成员在 .env 中通过 FEISHU_GROUP_<组名>=成员1,成员2,... 配置。名单外的调用先由智能体参考本策略综合判断，仍不放行则弹授权卡交负责人确认。修改即时生效（新会话起作用），/perm 可查看当前策略。",

  "admin": [
    "Read(**)",

    "Write(.agent/**)",
    "Write(data/**)",

    "Tools(*)",

    "Bash(git status:*)",
    "Bash(git diff:*)",
    "Bash(git log:*)",
    "Bash(git add:*)",
    "Bash(git commit:*)",
    "Bash(git push:*)",

    "Bash(npm run check:*)",
    "Bash(npm run test:*)",
    "Bash(npm test:*)",
    "Bash(npm install:*)",

    "Bash(npx:*)",
    "Bash(pip install:*)",
    "Bash(gh auth:*)",
    "Bash(lark-cli:*)"
  ],

  "group1": [
    "Read(docs/**)",
    "Read(.agent/skills/**)",

    "Tools(query_skill_usage)",

    "Bash(npm run test:*)",
    "Bash(npm run check:*)",
    "Bash(git status:*)",
    "Bash(git diff:*)",
    "Bash(git log:*)"
  ]
}