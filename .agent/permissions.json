{
  "_说明": "两个输入：deny=全局禁止读写的路径 glob 数组（第 0 层，先于一切 allow，对所有人含管理员生效），无内置默认、全部在此显式列出，可自行追加；allow=各身份组的规则数组，保留组名 common（所有人自动叠加）与 admin（FEISHU_PI_ADMIN 自动属于，权限仅来自显式规则），其余组名任取。组成员在 .env 配置：FEISHU_PI_GROUP=成员 对应主团队组 group，FEISHU_PI_GROUP_1/2…对应 group_1/2…，自定义组用 FEISHU_PI_GROUP_<组名>；成员可以是 open_id、中文名、英文名或组织架构部门名（用户部门路径含该名称即入组）。allow 内每条规则为 Read(路径glob)、Write(路径glob)、Tools(工具名)、Bash(命令) 格式；_ 开头的键视为注释。每次工具调用重新检查文件变化；/status 可查看身份组。",
  "deny": [
    ".env",
    "data/credentials/**",
    "data/.vault-key"
  ],
  "allow": {
    "common": [
      "Read(.agent/skills/**)",
      "Read(README.md)",
      "Read(.env.example)",
      "Read(docs/**)",
      "Tools(memory)",
      "Tools(schedule_manager)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run test:*)",
      "Bash(npm run check:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(wc:*)"
    ],
    "admin": [
      "Read(**)",
      "Write(.agent/**)",
      "Write(data/**)",
      "Tools(*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm run check:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(pip install:*)",
      "Bash(gh auth:*)",
      "Bash(lark-cli docs:*)",
      "Bash(lark-cli im:*)",
      "Bash(lark-cli contact:*)",
      "Bash(lark-cli base:*)",
      "Bash(lark-cli sheets:*)",
      "Bash(lark-cli wiki:*)",
      "Bash(lark-cli drive:*)",
      "Bash(lark-cli calendar:*)",
      "Bash(lark-cli task:*)",
      "Bash(lark-cli approval:*)",
      "Bash(lark-cli mail:*)",
      "Bash(lark-cli okr:*)",
      "Bash(lark-cli meeting:*)",
      "Bash(meegle:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(lark-cli --help)"
    ],
    "group": [
      "Read(docs/**)",
      "Bash(npm run test:*)",
      "Bash(npm run check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
