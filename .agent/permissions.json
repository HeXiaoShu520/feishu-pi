{
  "_说明": "common=所有人默认拥有的基础权限（每个用户自动叠加，无需归属）；admin=管理员组（FEISHU_ADMIN 或 FEISHU_GROUP_ADMIN 自动属于）；其余键=任意命名的组（如 group1、vip），在本组规则之上自动叠加 common。每条规则为 Read(路径glob)、Write(路径glob)、Tools(工具名)、Bash(命令) 格式。组成员在 .env 中通过 FEISHU_GROUP_<组名>=成员1,成员2,... 配置。修改即时生效（新会话起作用），/perm 可查看当前策略。",
  "common": [
    "Read(.agent/skills/**)",
    "Tools(query_skill_usage)"
  ],
  "admin": [
    "Read(**)",
    "Write(.agent/**)",
    "Write(data/**)",
    "Tools(*)",
    "Bash(git status:*)",
    "Bash(git diff:*)",
    "Bash(git log:*)",
    "Bash(git add:*)",
    "Bash(git commit:*)",
    "Bash(git push:*)",
    "Bash(npm run check:*)",
    "Bash(npm run test:*)",
    "Bash(npm test:*)",
    "Bash(npm install:*)",
    "Bash(npx:*)",
    "Bash(pip install:*)",
    "Bash(gh auth:*)"
  ],
  "group1": [
    "Read(docs/**)",
    "Bash(npm run test:*)",
    "Bash(npm run check:*)",
    "Bash(git status:*)",
    "Bash(git diff:*)",
    "Bash(git log:*)"
  ]
}
