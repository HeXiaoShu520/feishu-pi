{
  "_说明": "deny 与 allow 使用同一种通配语法：Bash(命令glob)、Read(路径glob)、Write(路径glob)、Tools(工具名glob)。命中 deny 不会永久拒绝，但会阻止白名单直通，连同规则作为风险上下文交给 LLM 门禁；LLM 仍可决定直接通过、管理员卡或用户本人卡。allow 只支持 admin（FEISHU_PI_ADMIN 识别）和 group（唯一团队，FEISHU_PI_GROUP 配置）；普通白名单命中直接通过，未命中统一交给 LLM 门禁，由它结合完整配置、调用者角色及是否管理员决定直接通过、管理员卡或用户本人卡。成员可用 open_id、中文名、英文名或部门名；_ 开头的键视为注释。每次工具调用重新检查文件变化；/status 可查看身份组。",
  "deny": [
    "Read(**/.env)",
    "Write(**/.env)",
    "Bash(**.env**)",
    "Read(**/.env.*)",
    "Write(**/.env.*)",
    "Bash(**.env.**)",
    "Read(data/credentials/**)",
    "Write(data/credentials/**)",
    "Bash(**data/credentials/**)",
    "Read(data/.vault-key)",
    "Write(data/.vault-key)",
    "Bash(**.vault-key**)"
  ],
  "allow": {
    "admin": [
      "Read(**)",
      "Write(.agent/**)",
      "Write(data/**)",
      "Tools(*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm run check:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(pip install:*)",
      "Bash(gh auth:*)",
      "Bash(lark-cli docs:*)",
      "Bash(lark-cli im:*)",
      "Bash(lark-cli contact:*)",
      "Bash(lark-cli base:*)",
      "Bash(lark-cli sheets:*)",
      "Bash(lark-cli wiki:*)",
      "Bash(lark-cli drive:*)",
      "Bash(lark-cli calendar:*)",
      "Bash(lark-cli task:*)",
      "Bash(lark-cli approval:*)",
      "Bash(lark-cli mail:*)",
      "Bash(lark-cli okr:*)",
      "Bash(lark-cli meeting:*)",
      "Bash(meegle:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(lark-cli --help)"
    ],
    "group": [
      "Read(.agent/skills/**)",
      "Read(README.md)",
      "Read(docs/**)",
      "Tools(memory)",
      "Tools(schedule_manager)",
      "Bash(ls:*)",
      "Bash(npm run test:*)",
      "Bash(npm run check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(wc:*)"
    ]
  }
}
